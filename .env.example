# Copy to .env. This is sourced by Bash; quote paths containing spaces.
# Linux default is ~/.cache/lelab. WSL E: example (mount drive first):
# LELAB_CACHE_ROOT=/mnt/e/lelab_cache
# Existing authentication can stay separate from the model cache:
# HF_TOKEN_PATH=/home/YOUR_USER/.cache/huggingface/token
# Optional stable device mapping (absolute path):
# LELAB_HARDWARE_CONFIG=/home/YOUR_USER/lelab_puls/config/hardware.local.json
# Optional own Windows recovery helper; see docs/hardware.md:
# LELAB_USB_RECOVERY_SCRIPT='C:\Users\YOUR_USER\usb_connect.ps1'
# HTTPS_PROXY=http://HOST:PORT
# HTTP_PROXY=http://HOST:PORT
# NO_PROXY=127.0.0.1,localhost,::1
# Work around a diagnosed Xet transfer failure (opt-in):
# HF_HUB_DISABLE_XET=1
